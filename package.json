{
  "name": "parthhub-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:learning": "pnpm --filter @parthhub/learning dev",
    "dev:server": "pnpm --filter @parthhub/server start:dev",
    "build:shared": "pnpm --filter @parthhub/shared build",
    "build:learning": "pnpm --filter @parthhub/learning build",
    "build:server": "pnpm --filter @parthhub/server build",
    "dev:teaching": "pnpm --filter @parthhub/teaching dev",
    "build:teaching": "pnpm --filter @parthhub/teaching build",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,scss,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
