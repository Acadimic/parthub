{
  "name": "parthhub-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:client": "pnpm --filter @parthhub/client dev",
    "dev:server": "pnpm --filter @parthhub/server start:dev",
    "build:shared": "pnpm --filter @parthhub/shared build",
    "build:client": "pnpm --filter @parthhub/client build",
    "build:server": "pnpm --filter @parthhub/server build",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,scss,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
