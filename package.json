{
  "name": "parthhub-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "bootstrap": "pnpm install && pnpm build:shared",
    "start:learning": "pnpm --filter @repo/learning dev",
    "start:server": "pnpm --filter @repo/server start:dev",
    "build:shared": "pnpm --filter @repo/shared build",
    "build:learning": "pnpm --filter @repo/learning build",
    "build:server": "pnpm --filter @repo/server build",
    "start:teaching": "pnpm --filter @repo/teaching dev",
    "build:teaching": "pnpm --filter @repo/teaching build",
    "start:support": "pnpm --filter @repo/support dev",
    "build:support": "pnpm --filter @repo/support build",
    "install:learning": "pnpm install --filter @repo/learning...",
    "install:teaching": "pnpm install --filter @repo/teaching...",
    "install:support": "pnpm install --filter @repo/support...",
    "install:server": "pnpm install --filter @repo/server...",
    "add:learning": "pnpm --filter @repo/learning add",
    "add:teaching": "pnpm --filter @repo/teaching add",
    "add:support": "pnpm --filter @repo/support add",
    "add:server": "pnpm --filter @repo/server add",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,scss,css}\"",
    "typecheck:ui": "pnpm --filter @repo/ui typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "volta": {
    "node": "24.21.0"
  }
}
