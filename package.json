{
  "name": "parthhub-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "start:learning": "pnpm --filter @repo/learning dev",
    "start:server": "pnpm --filter @repo/server start:dev",
    "build:shared": "pnpm --filter @repo/shared build",
    "build:learning": "pnpm --filter @repo/learning build",
    "build:server": "pnpm --filter @repo/server build",
    "start:teaching": "pnpm --filter @repo/teaching dev",
    "build:teaching": "pnpm --filter @repo/teaching build",
    "start:admin": "pnpm --filter @repo/admin dev",
    "build:admin": "pnpm --filter @repo/admin build",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,scss,css}\"",
    "typecheck:ui": "pnpm --filter @repo/ui typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "volta": {
    "node": "24.20.0"
  }
}
