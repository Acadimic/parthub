{
  "name": "@parthhub/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validations": {
      "types": "./dist/dtos/validations/index.d.ts",
      "default": "./dist/dtos/validations/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "validations": ["dist/dtos/validations/index.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
