{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@modules/*": ["src/modules/*"],
      "@config": ["src/config"],
      "@strategies": ["src/strategies"],
      "@decorators": ["src/decorators"],
      "@guards": ["src/guards"],
      "@interfaces": ["src/interfaces"],
      "@enums": ["src/enums"],
      "@utils": ["src/utils"],
      "@pipes": ["src/pipes"],
      "@base-schemas": ["src/base-schemas"],
      "@dtos": ["src/dtos"],
      "@constants": ["src/constants"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false
  }
}
