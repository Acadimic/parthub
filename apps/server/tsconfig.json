{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@modules/*": ["./src/modules/*"],
      "@secrets": ["./src/secrets"],
      "@secrets/*": ["./src/secrets/*"],
      "@decorators": ["./src/decorators"],
      "@decorators/*": ["./src/decorators/*"],
      "@guards": ["./src/guards"],
      "@interfaces": ["./src/interfaces"],
      "@enums": ["./src/enums"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@database/*": ["./src/database/*"],
      "@dtos": ["./src/dtos"],
      "@constants": ["./src/constants"]
    },
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false
  }
}
