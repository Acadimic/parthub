# Copy to .env.development — `pnpm start:server` loads that file via env-cmd.
# Only NODE_ENV and DB_URL are enforced (apps/server/src/secrets/secrets.validator.ts);
# every other key is @IsOptional(), so the server boots without them and the feature
# that needs one degrades. Names below are the ones the code reads via the Secrets enum.

# --- required ---
NODE_ENV=development
DB_URL=mongodb://127.0.0.1:27017/parthhub

# --- optional ---
PORT=9000

# Base64 of the Firebase service-account JSON. Without it the Firebase Admin app is
# not initialised and every authenticated route rejects; see firebase.service.ts.
FIREBASE_AUTH_BASE_64=

# Shared secret the support app sends as NEXT_PUBLIC_PRIVATE_API_KEY.
PRIVATE_API_KEY=

# S3. NOTE the names: s3.service.ts reads S3_BUCKET_NAME / S3_PUBLIC_BUCKET_NAME,
# not the AWS_S3_* spelling some older .env files use.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
S3_BUCKET_NAME=
S3_PUBLIC_BUCKET_NAME=

SENDGRID_API_KEY=

RAZORPAY_API_KEY=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SIGNATURE_SECRET=
