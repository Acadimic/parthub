# Copy to .env. Next.js inlines NEXT_PUBLIC_* at build time, so these are public —
# never put a server secret here. Restart the dev server after changing any of them.

# Base URL of the NestJS server, e.g. http://localhost:9000. The browser calls /api, which
# next.config.js rewrites here.
API_SERVER_URL=

# Firebase web config — the same project the server's FIREBASE_AUTH_BASE_64 points at.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_LEARN_URL=
